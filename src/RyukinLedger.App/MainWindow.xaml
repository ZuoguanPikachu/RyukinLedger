<Window x:Class="RyukinLedger.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RyukinLedger.App.Views"
        Title="硫金账本 · RyukinLedger" Height="930" Width="1180"
        MinHeight="890" MinWidth="960"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

    <!--
      暖色调浅色主题。立绘是白底的，浅色主题能让它自然融进去，不需要抠图。
    -->
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FDF9F4" Offset="0" />
            <GradientStop Color="#F8F4EF" Offset="0.5" />
            <GradientStop Color="#F0F3F7" Offset="1" />
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <!--
          约 70% 的白。这不是随便定的：最坏情况是立绘上一块饱和的红
          (#E86A50) 透上来，卡片会变成 #F8D2CA，深色文字在它上面的对比度
          仍有 11:1 左右，读数完全不受影响——所以可以放心再透一点。
        -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#B3FFFFFF" />
            <Setter Property="BorderBrush" Value="#E4D6C8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#2B2521" />
        </Style>

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Background" Value="#E8FFFFFF" />
            <Setter Property="BorderBrush" Value="#DCCDBC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#2B2521" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FFF4E6" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#D9B98A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 表头：去掉系统默认的灰色渐变，换成一条暖色细线 -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#E0D2C2" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="6,7" />
            <Setter Property="Foreground" Value="#8C8074" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Padding" Value="2,3" />
            <Setter Property="Foreground" Value="#3A322C" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <GridViewRowPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#F7EFE4" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#F2E4D2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!--
          背景立绘：整窗铺满，不做任何"留白给它"的布局安排——它就在所有控件后面，
          靠卡片的半透明透出来。
          这里拿到的图已经被 AssetLibrary 放到一块更大的画布上（垫的是图片自身边缘
          的颜色，见 BackgroundArtScale），所以人物不会再被放大成一整张大脸。对齐用
          Center：铺满 1180 宽后画面仍比窗口高约四分之一，上下对称地裁，人物在正中间。
          不透明度取 0.30 这一档：0.52 时透出来的人形还压着图表读数，再淡就只剩一层
          看不出是什么的暖色；0.30 是"看得出有画、又不跟数字抢"的位置。
        -->
        <Rectangle x:Name="BackdropArt" IsHitTestVisible="False" Opacity="0.30"
                   Visibility="Collapsed">
            <Rectangle.Fill>
                <ImageBrush x:Name="BackdropArtBrush"
                            Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
            </Rectangle.Fill>
            <Rectangle.Effect>
                <!--
                  固定「淡」档。两个极端都实测过：半径 12 时透过卡片只剩一团
                  认不出来是什么的色块；完全不透明 + 半径 3.5 又太抢眼，
                  压着图表读数。
                -->
                <BlurEffect Radius="6.0" KernelType="Gaussian" />
            </Rectangle.Effect>
        </Rectangle>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题与控制 -->
            <Grid Grid.Row="0" Margin="2,0,2,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#2B2521">
                        <Run Text="硫金账本" />
                        <Run Text="RyukinLedger" FontSize="13" FontWeight="Normal" Foreground="#9C8F82" />
                    </TextBlock>
                    <TextBlock x:Name="SubtitleText" FontSize="12" Foreground="#8C8074" Margin="0,4,0,0" />
                    <Border Height="2" Width="54" HorizontalAlignment="Left" Margin="0,8,0,0" CornerRadius="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#E8B15C" Offset="0" />
                                <GradientStop Color="#E2604A" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="StartButton" Content="开始记录" Style="{StaticResource ToolButton}"
                            Margin="0,0,8,0" Click="OnStartCoreClick" />
                    <Button x:Name="StopButton" Content="停止记录" Style="{StaticResource ToolButton}"
                            Margin="0,0,8,0" Click="OnStopCoreClick" />
                    <Button x:Name="OpenFolderButton" Content="打开数据目录" Style="{StaticResource ToolButton}"
                            Click="OnOpenDataFolderClick" />

                    <!-- 分隔线：左边是录制控制，右边是另一个工具，不是同一类 -->
                    <Border Width="1" Background="#E0D2C2" Margin="12,6,12,6" />

                    <Button x:Name="GachaButton" Content="抽卡计算器" Style="{StaticResource ToolButton}"
                            Click="OnOpenGachaClick" />
                </StackPanel>
            </Grid>

            <!--
              抓包状态：使用者最需要知道的一件事。它左边是原粹树脂。

              两张卡并排但彼此独立：右边说的是"内核现在在干什么"，左边是一个会自己往上
              走的数字。树脂不进左边那六张资源卡，因为它既没有收支曲线，点开也没有图表
              ——那六张是账本，它不是；放在状态条旁边只是因为两者都是"此刻"的信息，而
              这一行的余量本来就够。

              树脂的数值是推算出来的：游戏每 8 分钟 +1，但不会为这个 +1 发任何包，所以
              卡片上的数是"内核最后知道的数值 + 从那之后落下的拍数"。看到过一次 +1 之后，
              内核会把那次的时间写进 original_resin_last_increase_at，界面拿它做减法
              （两个时间点之间有几个 8 分钟边界），准确；只有登录同步值时才可能少 1。内核
              没在跑时数字后面跟一个问号：没人在确认这个数。
            -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="ResinCard" Style="{StaticResource Card}" Padding="12,8"
                        VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 缺图时整块留白由 ResinIcon 的 Visibility 决定，见 UpdateResin。 -->
                        <Image x:Name="ResinIcon" Width="26" Height="26" Margin="0,0,9,0"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />

                        <TextBlock Grid.Column="1" Text="原粹树脂" FontSize="12.5" Foreground="#8C8074"
                                   Margin="0,0,14,0" VerticalAlignment="Center" />

                        <!--
                          数字（连同它的问号）整块上抬 2px，好让它的视觉中心和左边那行中文
                          对齐。WPF 的 VerticalAlignment="Center" 居中的是"行框"：19px 的文
                          字生成约 25px 高的行框，上面留的是西文的升部余量、下面留的是降部余
                          量，而数字本身只占中偏下的 0.68em，于是行框居中时数字看起来比行框中
                          心低约 2.5px；中文方块字几乎填满字身，行框中心就是它的视觉中心。用
                          RenderTransform 而不是 Margin，是因为它不参与布局——行框仍然居中，
                          卡片高度、图标、左边那行字都不受影响。整数偏移也是刻意的：半个像素会
                          让 ClearType 的数字发糊。
                        -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel.RenderTransform>
                                <TranslateTransform Y="-2" />
                            </StackPanel.RenderTransform>

                            <TextBlock x:Name="ResinValueText" Text="—" FontSize="19"
                                       FontWeight="SemiBold" Foreground="#2B2521"
                                       VerticalAlignment="Center" />

                            <!--
                              只在这一个情况下有内容：内核没在跑，所以没有人在确认这个数
                              （问号的意义见 UpdateResin）。垂直居中——它挨着一个 19px 的
                              数字，贴底或贴顶都像是排版事故。
                            -->
                            <TextBlock x:Name="ResinMarkText" Text="" FontSize="14"
                                       Foreground="#A2968A" Margin="4,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1" x:Name="StatusBanner" Style="{StaticResource Card}"
                        Padding="14,9" Margin="12,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#C3B8AC"
                                 VerticalAlignment="Center" Margin="0,0,10,0" />

                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="StatusText" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="#2B2521" TextWrapping="Wrap" />
                            <TextBlock x:Name="StatusDetail" FontSize="12" Foreground="#7E7268"
                                       Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="392" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 资源 -->
                <!--
                  资源。

                  这一列的纵向排布是量出来的，不是估的：六张资源卡 + 抽数卡 +
                  账本概况卡，内容高 650px，而默认窗口（930）给这一列的视口是
                  678px —— 余量 28px，而且这已经是页脚折成两行的最坏情况。

                  所以这里的 1px 都乘三行卡片：一张卡长 9px，滚动条就回来了。
                  调字号、间距、内边距之前先算一遍这笔账。
                -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="资源" Style="{StaticResource SectionTitle}" Margin="2,0,0,4" />
                        <UniformGrid x:Name="CurrencyGrid" Columns="2" />

                        <!--
                          点卡片切换右边的图表：卡片本身就是选择器，所以没有下拉菜单。
                        -->
                        <Border Style="{StaticResource Card}" Padding="12" Margin="0,3,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="抽数" Style="{StaticResource SectionTitle}"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="PullTotalText" Grid.Column="1" Text="—"
                                               FontSize="21" FontWeight="SemiBold" Foreground="#2B2521"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <!--
                                  One per row: the name sits at the card's left
                                  edge and the count at its right, so the four
                                  counts line up in a single column and can be
                                  compared down the card.
                                -->
                                <views:PullSourcePicker x:Name="PullPicker" Columns="1"
                                                        Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="12" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="账本概况" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="LedgerSummaryText" FontSize="12" Foreground="#7E7268"
                                           Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 图表 -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Margin="4,0,4,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="ChartTitle" Text="每日收支" Style="{StaticResource SectionTitle}"
                                           VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ComboBox x:Name="RangeSelector" Width="104" Height="28"
                                              VerticalContentAlignment="Center"
                                              SelectionChanged="OnChartOptionChanged" />
                                </StackPanel>
                            </Grid>

                            <views:DailyChart x:Name="Chart" Grid.Row="1" MinHeight="170" />
                        </Grid>
                    </Border>

                    <!-- 最近记录 -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,12,0,0"
                            Height="240">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="最近记录" Style="{StaticResource SectionTitle}" Margin="4,0,0,8" />

                            <TextBlock x:Name="ActivityEmptyHint" Grid.Row="1"
                                       Text="还没有记录。启动抓包内核，然后进游戏登录即可。"
                                       Foreground="#9C8F82" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed" />

                            <ListView x:Name="ActivityList" Grid.Row="1" BorderThickness="0"
                                      Background="Transparent" FontSize="12"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="时间" Width="150"
                                                        DisplayMemberBinding="{Binding TimeText}" />
                                        <GridViewColumn Header="货币" Width="110"
                                                        DisplayMemberBinding="{Binding CurrencyText}" />
                                        <GridViewColumn Header="变动" Width="110"
                                                        DisplayMemberBinding="{Binding DeltaText}" />
                                        <GridViewColumn Header="余额" Width="120"
                                                        DisplayMemberBinding="{Binding BalanceText}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <TextBlock Grid.Row="3" x:Name="DiagnosticsText" FontSize="11" Foreground="#9C8F82"
                       Margin="2,10,2,0" TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Window>
