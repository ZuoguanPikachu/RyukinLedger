<Window x:Class="RyukinLedger.App.GachaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RyukinLedger.App.Views"
        Title="抽卡计算器" Height="640" Width="960"
        MinHeight="540" MinWidth="780"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner">

    <!-- 与主窗口同一套暖色调，避免开出来像是另一个程序 -->
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FDF9F4" Offset="0" />
            <GradientStop Color="#F8F4EF" Offset="0.5" />
            <GradientStop Color="#F0F3F7" Offset="1" />
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#E6FFFFFF" />
            <Setter Property="BorderBrush" Value="#E8DCD0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#2B2521" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#8C8074" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="25" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#2B2521" />
        </Style>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#8C8074" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 参数 -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="参数" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />

                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="目标数量（几个 UP 五星）" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="TargetSelector" Width="150" Height="30"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="OnInputChanged" />
                    </StackPanel>

                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="已垫抽数" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="PityBox" Width="150" Height="30" MaxLength="2"
                                 TextChanged="OnInputChanged" />
                    </StackPanel>

                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="捕获明光计数器" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="FateSelector" Width="110" Height="30"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="OnInputChanged" />
                    </StackPanel>

                    <!--
                      Bottom aligned at 6 px: that is what puts the centre of the
                      17 px check box on the centre line of the 30 px controls
                      beside it, rather than a few pixels below it.
                    -->
                    <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,6">
                        <CheckBox x:Name="GuaranteedCheck" Content="是否大保底"
                                  Checked="OnInputChanged" Unchecked="OnInputChanged" />
                    </StackPanel>
                </StackPanel>

                <!--
                  同一份选择也出现在主窗口的「可抽次数」卡片上：两处读写的是
                  同一个对象，所以不会出现两个窗口各算各的。
                -->
                <StackPanel Grid.Row="2" Margin="0,14,0,0">
                    <TextBlock Text="计入当前抽数的资源" Style="{StaticResource FieldLabel}" />
                    <!-- All four across: this window is wide enough for one row. -->
                    <views:PullSourcePicker x:Name="PullPicker" Columns="4" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 结果 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <UniformGrid Grid.Column="0" Columns="4">
                    <StackPanel>
                        <TextBlock x:Name="ExpectationText" Style="{StaticResource StatValue}" Text="—" />
                        <TextBlock Style="{StaticResource StatLabel}" Text="期望抽数" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="P50Text" Style="{StaticResource StatValue}" Text="—" />
                        <TextBlock Style="{StaticResource StatLabel}" Text="50% 概率内" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="P90Text" Style="{StaticResource StatValue}" Text="—" />
                        <TextBlock Style="{StaticResource StatLabel}" Text="90% 概率内" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="P99Text" Style="{StaticResource StatValue}" Text="—" />
                        <TextBlock Style="{StaticResource StatLabel}" Text="99% 概率内" />
                    </StackPanel>
                </UniformGrid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="CurrentPullsText" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="#2B2521" TextAlignment="Right" />
                    <TextBlock x:Name="PrimogemText" FontSize="12" Foreground="#8C8074"
                               TextAlignment="Right" Margin="0,5,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 分布 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10">
            <views:ProbabilityChart x:Name="ProbabilityChartControl" MinHeight="200" />
        </Border>

        <TextBlock Grid.Row="3" x:Name="HintText" FontSize="11" Foreground="#A2968A"
                   Margin="2,10,2,0" TextWrapping="Wrap" />
    </Grid>
</Window>
