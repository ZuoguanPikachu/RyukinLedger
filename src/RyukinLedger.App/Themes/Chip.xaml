<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      A Material-3-style filter chip, used for "which resources count towards my
      wishes" in both the main window and the calculator.

      The chip owns only its *shape* and its interaction states.  The three
      colours that say whether it is on or off are set from code, because they
      are per-currency: a selected chip is filled with a tint of the currency's
      own accent, the same colour its balance card uses, so the two read as the
      same thing.

      Hover is an overlay instead of a Background setter so it cannot fight with
      those code-set colours.
    -->
    <Style x:Key="CurrencyChip" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="10,0" />
        <!--
          Half a gutter on each side rather than a whole one on the right: that
          way the first chip is inset from the container edge by exactly the same
          amount as the last one, and two neighbours still sit 6 px apart.
        -->
        <Setter Property="Margin" Value="3,0,3,6" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <!--
                          8 px radius is the Material 3 chip shape.  It is
                          deliberately not a pill: the cards and buttons in this
                          window are all softly rounded rectangles, and a pill
                          would look like it came from another application.
                        -->
                        <Border x:Name="Chip"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>

                        <Border x:Name="Hover" CornerRadius="8" Background="#14000000"
                                Opacity="0" IsHitTestVisible="False" />

                        <!-- Keyboard focus still has to be visible. -->
                        <Border x:Name="Focus" CornerRadius="8" BorderThickness="2"
                                BorderBrush="#8C8074" Opacity="0" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Opacity" Value="0.6" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
