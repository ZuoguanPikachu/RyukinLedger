<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Shared control shapes, merged in App.xaml so the main window and the
      calculator cannot drift apart.

      Everything here is deliberately an *implicit* style (no x:Key): the point is
      that a ComboBox or a scroll bar anywhere in the application looks like it
      belongs to this window, and there is no list of places to remember to
      update when a new one is added.

      The palette matches the rest of the interface: the card border #E4D6C8, the
      button chrome #E8FFFFFF on #DCCDBC, the hover tint #FFF4E6, and the row
      highlight #F7EFE4 / #F2E4D2 that the activity list already uses.

      An input field and the drop-down therefore share one shape: the same
      7 px corner, the same #DCCDBC hairline, and the same hover and focus
      colours, so a row of controls reads as a row instead of as three
      unrelated widgets.
    -->

    <!-- ================================================================
         Scroll bar: 10 px wide, no arrows, a rounded translucent thumb.
         The track is invisible until the pointer is over it, because a list
         that always shows a grey groove draws more attention than the data.
         ================================================================ -->

    <Style x:Key="ScrollBarThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar" Margin="2" CornerRadius="3"
                            Background="#338C8074" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="#668C8074" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="#A68C8074" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <!--
                                  The page-up/down halves are transparent but still
                                  hit-testable, so clicking the groove pages the
                                  list the way it does everywhere else.
                                -->
                                <RepeatButton x:Name="PageUp" Command="ScrollBar.PageUpCommand"
                                              Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBarThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton x:Name="PageDown" Command="ScrollBar.PageDownCommand"
                                              Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            <Setter TargetName="PageUp" Property="Command" Value="ScrollBar.PageLeftCommand" />
                            <Setter TargetName="PageDown" Property="Command" Value="ScrollBar.PageRightCommand" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!--
              Only the thickness is fixed: a vertical bar stretches to its row and
              a horizontal one to its column, so the other dimension must stay
              auto or the bar collapses to a 10 px square.
            -->
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================================================================
         Drop-down: the closed box keeps the same 7 px corner as the tool
         buttons, and the list that drops out of it is a rounded card with a
         hairline border instead of the square system popup.
         ================================================================ -->

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="#3A322C" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Row" CornerRadius="5" Background="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="#F7EFE4" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="#F2E4D2" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="#2B2521" />
        <Setter Property="FontSize" Value="12.5" />
        <!-- Left inset for the text, right inset for the chevron. -->
        <Setter Property="Padding" Value="10,0,26,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!--
                          The whole box is one button, so clicking anywhere, not
                          just on the text, opens the list.
                        -->
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Box" CornerRadius="7"
                                            Background="#E8FFFFFF"
                                            BorderBrush="#DCCDBC"
                                            BorderThickness="1" />
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Box" Property="Background" Value="#FFF4E6" />
                                            <Setter TargetName="Box" Property="BorderBrush" Value="#D9B98A" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Box" Property="Background" Value="#FFF4E6" />
                                            <Setter TargetName="Box" Property="BorderBrush" Value="#D9B98A" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          IsHitTestVisible="False" />

                        <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center"
                              Margin="0,0,11,0" Data="M 0,0 L 4.5,4.5 L 9,0"
                              Stroke="#8C8074" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False" />

                        <!--
                          AllowsTransparency is what makes the rounded corners
                          possible: without it the popup is a plain rectangular
                          window and the corners would show the page behind them.

                          There is deliberately no DropShadowEffect on the card.
                          A popup window is exactly as large as its content, so the
                          part of a shadow that falls outside gets cut off with a
                          hard edge, and that cut shows up as a square corner
                          sitting just outside the rounded border.  Padding the
                          content does not help either: the extra room lands on the
                          right and bottom only, which shifts the card instead of
                          framing it.  The 1 px border is what separates the list
                          from whatever is behind it.
                        -->
                        <Popup x:Name="PART_Popup" Placement="Bottom" PopupAnimation="Fade"
                               AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border x:Name="Drop" Margin="0,4,0,0" CornerRadius="7"
                                    Background="#FFFFFFFF"
                                    BorderBrush="#E4D6C8"
                                    BorderThickness="1"
                                    MinWidth="{Binding ActualWidth,
                                               RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer Margin="4" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Arrow" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================
         Input field: the drop-down's closed box, without the chevron.  It is
         a separate style rather than a shared template because a TextBox has
         to keep a real content host for the caret and the selection, but the
         two must stay visually identical, hence the same numbers.
         ================================================================ -->

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="#2B2521" />
        <Setter Property="FontSize" Value="12.5" />
        <!-- Same left inset as the drop-down text, so the two line up. -->
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="#8C6A3F" />
        <Setter Property="SelectionBrush" Value="#D9B98A" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Box" CornerRadius="7"
                            Background="#E8FFFFFF"
                            BorderBrush="#DCCDBC"
                            BorderThickness="1">
                        <!--
                          No Margin="{TemplateBinding Padding}" here: TextBoxBase
                          already insets the text by Padding itself, and adding it
                          to the content host as well doubles it (the text then
                          starts 20 px in instead of 10, which is visibly out of
                          line with the drop-downs beside it).

                          The content host follows VerticalContentAlignment: the
                          single-line fields here are all 30 px tall, and text
                          pinned to the top of a 30 px box looks like a mistake.
                        -->
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="#FFF4E6" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="#D9B98A" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <!-- White, so the caret sits on a calm surface. -->
                            <Setter TargetName="Box" Property="Background" Value="#FFFFFFFF" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="#D9B98A" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================
         Check box: a rounded 17 px well that fills with the warm accent when
         it is on.  The system box is the one control in the calculator that
         still looked like Windows 7 next to the rounded drop-downs.
         ================================================================ -->

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="#2B2521" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- Transparent background so the gap between box and label is clickable too. -->
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="17" Height="17" CornerRadius="5"
                                Background="#E8FFFFFF"
                                BorderBrush="#CBB9A6"
                                BorderThickness="1.5"
                                VerticalAlignment="Center">
                            <!--
                              The tick's layout box is its geometry bounds, which
                              exclude the stroke, so it centres about a pixel high.
                            -->
                            <Path x:Name="Tick" Data="M 0,4 L 3.2,7.2 L 8.4,1"
                                  Stroke="#FFFFFF" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Margin="0,1,0,0" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="#D9B98A" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="#D9B98A" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <!--
                          Two multi-triggers instead of one hover trigger: an
                          unconditional hover would have to be declared after the
                          checked state and would then flatten the filled look.
                        -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Box" Property="Background" Value="#FFF4E6" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="#D9B98A" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Box" Property="Background" Value="#C9A574" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="#C9A574" />
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="#8C8074" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
